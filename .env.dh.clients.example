# =============================================================================
# Required Configuration
# =============================================================================
# Loaded only for `dh clients ...` commands.

# Client driver(s) to test (comma-separated, e.g., 'java,typescript,python,go,csharp', or 'all')
# CLIENT_DRIVERS=

# =============================================================================
# Optional Configuration
# =============================================================================

# Whether to delete the managed client repo clones and start over
# CLEAN=false

# Whether to stop after the first test failure
# BAIL=false

# Reranking API key, used by reranking tests. Defaults to the Astra token on Astra;
# a DataStax dev Astra token is required on HCD
# RERANKING_API_KEY=

# CQL contact point for astrapy's own tests, against a non-local HCD target.
# Only used with `--local`, where it defaults to 127.0.0.1
# LOCAL_CASSANDRA_CONTACT_POINT=

# =============================================================================
# Embedding Provider Credentials
# =============================================================================
# Credentials for the embedding providers exercised by vectorize tests
# Format: EMBEDDING_API_KEY_<PROVIDER>=<key>
#
# <PROVIDER> is the Data API's own provider name (case-insensitive), e.g. OPENAI, NVIDIA
#
# Examples:
#   EMBEDDING_API_KEY_OPENAI=sk-...
#   EMBEDDING_API_KEY_NVIDIA=nvapi-...
