# =============================================================================
# Common Configuration
# =============================================================================
# Loaded by every `dh` command, regardless of which group (docs, clients, db, ...) it's under.

# Enable/disable spinner in the CLI output
# SPINNER=true

# =============================================================================
# Database Connection
# =============================================================================
# Used by any command that connects to a target database (docs run/test, clients test, db
# bootstrap/clean). Can be overridden per-invocation via '-t/--astra-token' and '-e/--api-endpoint'.

# Astra token for authentication
# ASTRA_TOKEN=

# Target database API endpoint
# API_ENDPOINT=

# =============================================================================
# External Program Command Overrides
# =============================================================================
# Override the command used to invoke external programs
# Format: <PROGRAM>_COMMAND=<command>
#
# Available programs: TSX, NPM, BASH, PYTHON, JAVA, DOTNET, JQ, GO, GIT, NODE, UV, MVN
#
# Examples:
#   TSX_COMMAND=npx -y tsx
#   BASH_COMMAND=/usr/bin/bash
#   PYTHON_COMMAND=python3.11
#   JAVA_COMMAND=/usr/lib/jvm/java-21/bin/java
